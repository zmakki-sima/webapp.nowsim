# Yesim Partner API. Server-side only — never prefix with NEXT_PUBLIC_.
# The token travels in the query string, so it must never reach a log or a
# browser. lib/api/yesim.ts redacts it from every error it throws.
YESIM_API_TOKEN=

# Bearer token for POST /api/revalidate, which purges the catalog or device
# caches on demand. 16 chars minimum:
#   openssl rand -base64 32
# Unset, the route answers 503 and the caches only refresh on their own
# schedule — set it in production or on-demand purges silently do nothing.
REVALIDATE_SECRET=

# --- Auth ---------------------------------------------------------------
# Everything below is read lazily by lib/auth/env.ts, so the catalog still
# boots without it. The first sign-in attempt is what fails.

# Session cookie encryption key. 32 bytes, base64:
#   openssl rand -base64 32
SESSION_SECRET=

# Upstash Redis (REST). Holds OTP codes, attempt counters and rate limits.
# https://console.upstash.com → your database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend. Without a key, `next dev` prints the code to the server console
# instead of sending it; in production a missing key is a hard error.
RESEND_API_KEY=
# Must be on a domain verified in Resend, or the codes land in spam. The
# sandbox sender below is dev-only — it reaches nobody but the Resend account
# owner. Production requires this set to a verified domain and rejects any
# @resend.dev address.
AUTH_EMAIL_FROM="nowsim <onboarding@resend.dev>"

# Absolute origin, used wherever no request is in scope: links inside emails and
# the pages Stripe returns a customer to. Required in production, and rejected
# there if it points at localhost. Defaults to http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=

# --- Payments -----------------------------------------------------------
# Read lazily by lib/payments/env.ts, so the catalog still boots without it.
# The first payment attempt is what fails.

# Stripe API key. Server-side only — never prefix with NEXT_PUBLIC_.
# https://dashboard.stripe.com/test/apikeys
# Must be sk_test_ outside production and sk_live_ in it. A live key in a test
# run charges real cards; a test key in production takes money that never
# settles, so the mode is checked rather than trusted.
STRIPE_SECRET_KEY=

# Proves an incoming webhook really came from Stripe. Without it, anyone who
# guesses the URL can claim an order was paid and collect a free eSIM.
# Local:      stripe listen --forward-to localhost:3000/api/stripe/webhook
# Deployed:   dashboard → Developers → Webhooks → your endpoint → signing secret
# The local secret and the deployed one are different values.
STRIPE_WEBHOOK_SECRET=
