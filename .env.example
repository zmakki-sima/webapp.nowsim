# Yesim Partner API. Server-side only — never prefix with NEXT_PUBLIC_.
# The token travels in the query string, so it must never reach a log or a
# browser. lib/api/yesim.ts redacts it from every error it throws.
YESIM_API_TOKEN=

# Bearer token for POST /api/revalidate, which purges the catalog or device
# caches on demand. 16 chars minimum:
#   openssl rand -base64 32
# Unset, the route answers 503 and the caches only refresh on their own
# schedule — set it in production or on-demand purges silently do nothing.
REVALIDATE_SECRET=

# --- Auth ---------------------------------------------------------------
# Everything below is read lazily by lib/auth/env.ts, so the catalog still
# boots without it. The first sign-in attempt is what fails.

# Session cookie encryption key. 32 bytes, base64:
#   openssl rand -base64 32
SESSION_SECRET=

# Upstash Redis (REST). Holds OTP codes, attempt counters and rate limits.
# https://console.upstash.com → your database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend. Without a key, `next dev` prints the code to the server console
# instead of sending it; in production a missing key is a hard error.
RESEND_API_KEY=
# Must be on a domain verified in Resend, or the codes land in spam. The
# sandbox sender below is dev-only — it reaches nobody but the Resend account
# owner. Production requires this set to a verified domain and rejects any
# @resend.dev address.
AUTH_EMAIL_FROM="nowsim <onboarding@resend.dev>"

# Absolute origin for links inside emails. Mail is rendered outside a request,
# so it cannot read the host. Defaults to https://nowsim.com when unset.
NEXT_PUBLIC_SITE_URL=
